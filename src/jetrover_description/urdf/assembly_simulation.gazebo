    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="front_left_wheel_tire_1">
    <material>${body_color}</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <self_collide>false</self_collide>
