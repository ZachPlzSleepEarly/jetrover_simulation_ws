    <parent link="base_link" />
    <child link="wheel_left_back_1" />
    <axis xyz="0.00116 0.999999 0.0" />
  </joint>

  <joint name="joint_right_back" type="continuous">
    <origin xyz="-0.102022 -0.098804 0.05207" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="wheel_right_back_1" />
    <axis xyz="0.0 -1.0 0.0" />
  </joint>

  <joint name="shaft_joint_right_front" type="revolute">
    <origin xyz="0.111122 -0.064188 0.073" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="right_turn_shaft_1" />
    <axis xyz="0.0 0.0 1.0" />
    <limit upper="0.645772" lower="-0.645772" effort="100" velocity="100" />
  </joint>

  <joint name="shaft_joint_left_front" type="revolute">
    <origin xyz="0.111055 0.062677 0.073" rpy="0 0 0" />
