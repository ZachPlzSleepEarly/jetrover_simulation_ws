<?xml version="1.0"?>
<robot name="jetrover_rebuild" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find jetrover_rebuild_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find jetrover_rebuild_description)/urdf/jetrover_rebuild.trans" />
  <xacro:include filename="$(find jetrover_rebuild_description)/urdf/jetrover_rebuild.gazebo" />
  <link name="base_footprint" />
  <joint name="base_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>
  <link name="base_link">
